widget "tu bondi" {
  page: 1
  order: 3
  size: 3x3
  minSize: 3x2
  meta { description: "Proximos arribos de Tu Bondi en Cordoba para una o mas paradas (por defecto A911, lineas 40/42/71). Toca para ver todo por parada y configurar."; version: "1.1"; license: "GPL-3.0-only"; category: "home"; owl: 5 }

  requires { pacman: ["curl", "jq"] }

  state stopsStr = "A911" persist
  state linesStr = "40,42,71" persist

  source now = clock every 30s
  source board = cmd("""
cj=$(mktemp)
curl -s -c $cj -b $cj -A "TuBondi-Tracker-Widget/1.0" "https://micronauta4.dnsalias.net/web/urbano/?conf=cbaciudad" -o /dev/null --max-time 10 || true
tmp=$(mktemp)
live=0
stops="${stopsStr}"
oldifs=$IFS
IFS=,
set -- $stops
IFS=$oldifs
for code in "$@"; do
  code=$(printf '%s' "$code" | tr -d '[:space:]')
  [ -z "$code" ] && continue
  resp=$(curl -s -c $cj -b $cj -A "TuBondi-Tracker-Widget/1.0" -H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" -H "X-Requested-With: XMLHttpRequest" -H "Referer: https://micronauta4.dnsalias.net/web/urbano/?conf=cbaciudad" --data-urlencode "conf=cbaciudad" --data-urlencode "codigo=$code" --data-urlencode "show80min=true" --data-urlencode "onlygps_array={}" --data-urlencode "cmd=proximos_arribos" "https://micronauta4.dnsalias.net/usuario/urbano2_cmd.php" --max-time 15 || true)
  if [ -n "$resp" ]; then
    part=$(printf '%s' "$resp" | jq -c --arg code "$code" '
      def parse_eta:
        if . == null or . == "" then null
        elif ascii_downcase | test("arrib|llega") then 0
        else (match("[0-9]+").string | tonumber? // null) end;
      {
        code: $code,
        desc: (.parada.descripcion // ""),
        arrivals: ((.proximos_arribos // []) | map({
          stop: $code,
          line: (.linea // "?"),
          dest: (.ruta_descripcion // .ruta // ""),
          route: (.ruta // ""),
          etaTxt: (.demora // .proximo // ""),
          eta: ((.demora // .proximo // "") | parse_eta),
          dist: .distancia,
          color: (.color // "#ffb300"),
          op: (.cliente_nombre // ""),
          notif: (.notificacion // "")
        }))
      }' 2>/dev/null || true)
    if [ -n "$part" ]; then
      printf '%s\n' "$part" >> $tmp
      live=1
      continue
    fi
  fi
  printf '{"code":"%s","desc":"","arrivals":[]}\n' "$code" >> $tmp
done
rm -f $cj
if [ "$live" = 1 ]; then
  jq -c -s '{stops: map({code: .code, desc: .desc}), arrivals: [.[].arrivals[]], updated: (now | floor), error: null}' $tmp 2>/dev/null || printf '{"stops":[],"arrivals":[],"updated":%s,"error":"parse"}\n' $(date +%s)
else
  codes=$(printf '%s' "${stopsStr}" | jq -R -c 'split(",") | map(gsub("[\\s]";"") | ascii_upcase) | map(select(. != "")) | map({code: ., desc: "", arrivals: []})' 2>/dev/null || echo "")
  if [ -z "$codes" ] || [ "$codes" = "null" ]; then
    printf '{"stops":[],"arrivals":[],"updated":%s,"error":"offline"}\n' $(date +%s)
  else
    printf '{"stops":%s,"arrivals":[],"updated":%s,"error":"offline"}\n' "$codes" $(date +%s)
  fi
fi
rm -f $tmp
  """) every 60s json timeout 25s status

  let data = board.ok ? board.out : null
  let stops = data.stops ?? []
  let multi = len(stops) > 1
  let firstCode = trim(split(stopsStr ?? "", ",")[0] ?? "")
  let linesList = split(linesStr ?? "", ",").map(s => trim(s)).filter(s => s != "")
  let all = data.arrivals ?? []
  let arrivals = all.filter(a => len(linesList) == 0 || contains(linesList, a.line)).sortBy(a => a.eta ?? 9999).take(6)
  let notifs = arrivals.filter(a => trim(a.notif ?? "") != "").take(2)
  let updated = data.updated
  let err = board == null ? null : !board.ok ? "offline (codigo ${board.code})" : data.error

  onTap: screen()

  component ArrivalRow(a, showStop) {
    Column {
      gap: 0
      Row {
        gap: 6
        align: center
        Box { width: 10; height: 10; background: a.color ?? accent }
        Text { text: showStop ? "${a.line} · ${a.stop}" : a.line; bold: true; weight: 1; maxLines: 1 }
        Text { text: a.etaTxt; bold: true; width: 62; align: end; maxLines: 1; color: (a.eta ?? 99) <= 5 ? green : (a.eta ?? 99) <= 15 ? yellow : foreground }
      }
      Text { text: a.dest; style: small; maxLines: 1 }
      Text { text: a.dist == null ? a.op : "${fixed(a.dist, 1)} km · ${a.op}"; style: label; color: muted; maxLines: 1 }
    }
  }

  Column {
    gap: 4
    Row {
      gap: 6
      align: center
      Text { text: multi ? "bondi ×${len(stops)}" : "bondi ${firstCode}"; style: muted; weight: 1; maxLines: 1 }
      Text { text: fmtTime(now, "HH:mm"); style: small; color: muted; width: 44; align: end }
    }
    if board == null {
      Text { text: "cargando…"; style: small; color: muted }
    } else if err != null || len(arrivals) == 0 {
      if multi {
        Text { text: stopsStr; style: label; color: muted; maxLines: 1 }
      } else if (stops[0].desc ?? "") != "" {
        Text { text: lower(stops[0].desc); style: label; color: muted; maxLines: 1 }
      }
      Text { text: err ?? "sin arribos ahora"; style: small; color: err != null ? red : muted; maxLines: 2 }
      Text { text: updated == null ? "revisa tu conexion" : "actualizado ${fmtTime(updated, "HH:mm")}"; style: label; color: muted }
      Row {
        justify: end
        Button { text: "reintentar"; color: muted; onTap: refresh() }
      }
    } else {
      for a in arrivals.take(2) key "${a.stop}-${a.line}-${a.route}-${a.etaTxt}" {
        ArrivalRow { a: a; showStop: multi }
      }
      if len(notifs) > 0 {
        Text { text: "⚠ ${trim(notifs[0].notif)}"; style: label; color: yellow; maxLines: 1 }
      }
      Spacer { weight: 1 }
      Text { text: "actualizado ${fmtTime(updated, "HH:mm")}"; style: label; color: muted; maxLines: 1 }
    }
  }

  screen {
    title: multi ? "tu bondi ×${len(stops)}" : "tu bondi ${firstCode}"
    Column {
      scroll: true
      gap: 10
      Row {
        gap: 6
        align: center
        Text { text: fmtTime(now, "HH:mm:ss"); fontSize: 28; bold: true; font: mono; width: 120 }
        Text { text: updated == null ? "sin datos" : "actualizado ${fmtTime(updated, "HH:mm:ss")}"; style: small; color: muted; weight: 1 }
        Button { text: "↻"; color: muted; onTap: refresh() }
      }
      if board == null {
        Text { text: "cargando arribos…"; style: body; color: muted }
      } else if err != null {
        Text { text: "${err}: no se pudo consultar Tu Bondi (micronauta4.dnsalias.net). Puede ser de noche sin servicio o la sesion PHPSESSID caduco."; style: body; color: red }
        Text { text: "paradas: ${stopsStr}"; style: small; color: muted }
        Button { text: "reintentar ahora"; onTap: refresh() }
      } else if len(arrivals) == 0 {
        Text { text: "sin arribos para ${linesStr} ahora mismo."; style: body; color: muted }
        Text { text: "paradas: ${stopsStr}"; style: small; color: muted }
      } else {
        for s in stops key s.code {
          let sa = arrivals.filter(a => a.stop == s.code)
          Column {
            gap: 4
            Text { text: s.desc == "" ? "parada ${s.code}" : lower(s.desc); style: label; color: accent; maxLines: 2 }
            Text { text: "parada ${s.code}"; style: small; color: muted }
            if len(sa) == 0 {
              Text { text: "sin arribos para ${linesStr}"; style: small; color: muted }
            } else {
              for a in sa key "${a.line}-${a.route}-${a.etaTxt}" {
                Column {
                  gap: 2
                  padding: [10, 8]
                  border: 1
                  borderColor: alpha(muted, 0.3)
                  ArrivalRow { a: a; showStop: false }
                  if trim(a.notif ?? "") != "" {
                    Text { text: "⚠ ${trim(a.notif)}"; style: label; color: yellow; maxLines: 3 }
                  }
                }
              }
            }
          }
        }
      }
      if len(notifs) > 0 {
        Text { text: "avisos de la linea"; style: label; color: accent }
        for n in notifs key "${n.stop}-${n.line}-${n.etaTxt}" {
          Text { text: "[${n.line} · ${n.stop}] ${trim(n.notif)}"; style: small; color: yellow; maxLines: 4 }
        }
      }
      Text { text: "paradas y lineas"; style: label; color: accent }
      Input { text: stopsStr; placeholder: "paradas (A911,A45)"; onSubmit: stopsStr = join(split(value ?? "", ",").map(s => trim(upper(s))).filter(s => s != ""), ",") }
      Input { text: linesStr; placeholder: "lineas (40,42,71)"; onSubmit: linesStr = join(split(value ?? "", ",").map(s => trim(s)).filter(s => s != ""), ",") }
      Text { text: "una o mas paradas separadas por coma: las de casa y trabajo, por ejemplo A911,A45. Se consultan todas con la misma sesion y se ordenan por ETA."; style: small; color: muted }
      Text { text: "para grupos independientes (casa / trabajo) duplica el archivo: 30-tu-bondi-casa.owl y 31-tu-bondi-trabajo.owl, cada uno con su estado."; style: small; color: muted }
      Row {
        justify: end
        Button { text: "abrir tu bondi ↗"; color: muted; onTap: url("https://micronauta4.dnsalias.net/web/urbano/?conf=cbaciudad") }
      }
      Row {
        justify: end
        Button { text: "ver repo original ↗"; color: muted; onTap: url("https://github.com/LucioB16/Tu-Bondi-Tracker") }
      }
    }
  }
}
